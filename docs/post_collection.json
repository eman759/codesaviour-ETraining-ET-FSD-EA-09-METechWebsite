{
  "info": {
    "name": "ME Technologies API",
    "description": "Postman collection for testing authentication, services, courses and batches APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@metech.com\",\n  \"password\": \"YOUR_ADMIN_PASSWORD\"\n}"
            },
            "url": "http://localhost:5000/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Services",
      "item": [
        {
          "name": "Get All Services",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/services"
          }
        },
        {
          "name": "Create Service",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer YOUR_ADMIN_TOKEN"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Service\",\n  \"slug\": \"test-service\",\n  \"description\": \"Test service for API\",\n  \"icon\": \"zap\",\n  \"order\": 7,\n  \"shortText\": \"Testing our services API\"\n}"
            },
            "url": "http://localhost:5000/api/services"
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "Get All Courses",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/courses"
          }
        },
        {
          "name": "Create Course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer YOUR_ADMIN_TOKEN"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Course\",\n  \"slug\": \"test-course\",\n  \"description\": \"Temporary course for API testing\",\n  \"duration\": \"1 week\",\n  \"fee\": 0,\n  \"tools\": [\"AutoCAD\"],\n  \"outline\": [\"Basic testing\"]\n}"
            },
            "url": "http://localhost:5000/api/courses"
          }
        }
      ]
    },
    {
      "name": "Batches",
      "item": [
        {
          "name": "Get All Batches",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/batches"
          }
        },
        {
          "name": "Create Batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer YOUR_ADMIN_TOKEN"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Batch\",\n  \"course\": \"6ad0a0d88650a52031f6e35b\",\n  \"startDate\": \"2026-11-01\",\n  \"endDate\": \"2026-11-29\",\n  \"totalSeats\": 20,\n  \"mode\": \"online\",\n  \"status\": \"upcoming\"\n}"
            },
            "url": "http://localhost:5000/api/batches"
          }
        }
      ]
    }
  ]
}